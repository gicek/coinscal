// Website deployment: Cloudflare Workers Static Assets, no Worker code. Deploy with `make site-deploy`.
{
  "$schema": "https://unpkg.com/wrangler@4.137.0/config-schema.json",
  "name": "coinscal-site",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "coinscal.app", "custom_domain": true },
    { "pattern": "coinscal.gicek.com", "custom_domain": true }
  ]
}
